import Lean

/-!
# The `async` runner tag

The provenance marker for compiled machines: `async` tags every `run` it generates with
`machineAttr`, and the machine-call classifier accepts a `*.run` only when the tag is present — the
difference between "a compiled machine's runner" and any hand-written function that happens to end in
`run` (or a hand-built inductive named to look like a state type).
-/

namespace LeanIn.Async

/-- The tag: present on a `run` declaration iff `async` generated it. The `validate` rejects the
attribute's *manual* application in source — the tag is written only by the macro's own programmatic
registration, which does not pass through `validate`. -/
initialize machineAttr : Lean.TagAttribute ←
  Lean.registerTagAttribute `leaninAsyncMachine "a `run` generated by `async`"
    (validate := fun _ => throwError
      "`leaninAsyncMachine` is applied by `async` to the `run` it generates; it may not be applied by hand")

/-- The spawn tag: present on a `spawn` declaration iff `async` generated it, so a hand-written
function beside a tagged `run` cannot be classified as the machine-spawn effect. -/
initialize spawnAttr : Lean.TagAttribute ←
  Lean.registerTagAttribute `leaninAsyncMachineSpawn "a `spawn` generated by `async`"
    (validate := fun _ => throwError
      "`leaninAsyncMachineSpawn` is applied by `async` to the `spawn` it generates; it may not be applied by hand")

end LeanIn.Async
